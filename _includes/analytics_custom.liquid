{% comment %}
  Cookieless Google Analytics 4.

  Loads GA4 with `client_storage: 'none'`, so it stores no cookies or
  localStorage on the visitor's device. Because nothing is stored on the
  device, no ePrivacy cookie-consent banner is required. You still get
  pageviews, engagement time, approximate location, referrers, and device
  info; GA4 anonymizes IP by default.

  Set your Measurement ID in _config.yml as `ga4_cookieless: G-XXXXXXXXXX`.
  Leave `analytics.google` blank so the standard (cookie-based) tag is not
  also injected.
{% endcomment %}
{% assign ga4_id = site.ga4_cookieless %}
{% if ga4_id and ga4_id != "" %}
  <!-- Google Analytics 4 (cookieless) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "{{ ga4_id }}", { client_storage: "none" });
  </script>
{% endif %}
